# ============================================================
# EV Intelligence Platform — .gitignore
# ============================================================

# ── Python bytecode & caches ─────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Virtual environments ─────────────────────────────────────
.venv
venv/
ENV/
env/
env.bak/
venv.bak/
.conda/

# ── Environment & secrets — NEVER commit these ───────────────
.env
.env.local
.env.*.local
*.env
secrets.toml
.secrets/

# Streamlit secrets (NEVER commit)
.streamlit/secrets.toml

# ── ChromaDB vector store (auto-rebuilt on first run) ─────────
ev_intelligence/chroma_store/
chroma_store/

# ── Kaggle datasets (large — distribute via Kaggle API) ──────
*.csv
*.xlsx
*.xls
*.parquet
*.feather

# ── OS files ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ── IDE / editor ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Build / dist ─────────────────────────────────────────────
build/
dist/
*.egg-info/
.eggs/

# ── Testing & coverage ───────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
pip-log.txt

# ── Temporary & data runtime directories ─────────────────────
*.tmp
*.bak
tmp/
temp/
ev_intelligence/data/

# ── Large ML artefacts (downloaded at runtime) ───────────────
*.pkl
*.pickle
*.h5
*.onnx
*.pt
*.pth
