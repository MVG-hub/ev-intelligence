# ─────────────────────────────────────────────────────────────────────────────
# .env.example — EV Intelligence Platform
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Optional: Mapbox token for premium map tiles (free tier available)
# MAPBOX_TOKEN=pk.eyJ1IjoiWU9VUl9VU0VSTkFNRSIsI...

# Optional: OpenAI API key (to use GPT embeddings instead of built-in model)
# OPENAI_API_KEY=sk-...

# Optional: HuggingFace token (for private model downloads)
# HF_TOKEN=hf_...

# Optional: Anthropic API key (for Claude-based generation)
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Kaggle API credentials (for automated dataset download)
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key

# Optional: Override default ports / paths
# STREAMLIT_SERVER_PORT=8501
# DATA_DIR=/app/data
